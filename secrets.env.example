# Copy this file to secrets.env and fill in real values.
# Source it before running any radio script:  . ./secrets.env

# Your personal Telegram bot token and chat ID (morning / evening / sleep radio)
export TG_BOT_TOKEN="<your-bot-token>"
export TG_CHAT_ID="<your-chat-id>"

# Second channel (wife's radio)
export TG_BOT_TOKEN_WIFE="<wife-bot-token>"
export TG_CHAT_ID_WIFE="<wife-chat-id>"
