# Copy this file to secrets.env and fill in real values.
# Source it before running any radio script:  . ./secrets.env

# Your personal Telegram bot token and chat ID (morning / evening / sleep radio)
export TG_BOT_TOKEN="<your-bot-token>"
export TG_CHAT_ID="<your-chat-id>"

# Second channel (wife's radio)
export TG_BOT_TOKEN_WIFE="<wife-bot-token>"
export TG_CHAT_ID_WIFE="<wife-chat-id>"

# City used for weather in all radio scripts
export CITY_FOR_WEATHER="<your-city>"

# Listener names (used in greetings)
export LISTENER_NAME="<listener-name>"
export WIFE_NAME="<wife-name>"

# Professional profile for the second listener — used in Claude prompts to personalise content.
# Example: "是CPA、国际税高级经理，就职于某行业，日常处理合规、税务、并购等事务"
export WIFE_PROFILE="<second-listener-professional-background>"

# Personal profile for the primary listener — used in the evening radio Claude prompt.
# Example: "白天从事技术工作；喜欢茶文化、历史、旅行、美食；重视家庭与安静感"
export OWNER_PROFILE="<your-personal-interests-and-lifestyle>"
